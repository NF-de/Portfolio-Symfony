{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block body %}

<div class="background-fumee"></div>

<div class="scroll-zone">
    <div class="scroll-content"></div>
    <div class="scroll-overlay"></div>
</div>

<main>

    <div class="cards-container">

        <div class="register-wrapper">

            <form method="post" class="card card-center">

                <h2 class="titre-section">Inscription</h2>

                {{ form_errors(registrationForm) }}

                <label>Nom</label>
                {{ form_widget(registrationForm.nom, {'attr': {'placeholder': 'Nom'}}) }}

                <label>Prénom</label>
                {{ form_widget(registrationForm.prenom, {'attr': {'placeholder': 'Prénom'}}) }}

                <label>Email</label>
                {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'Email'}}) }}

                <label>Mot de passe</label>
                {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder': 'Mot de passe'}}) }}

                <div class="checkbox-label">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    <span>J’accepte les conditions</span>
                </div>

                <button type="submit" class="btn-scenik">S’inscrire</button>

                <p style="margin-top:15px;">
                    Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
                </p>

            </form>

        </div>

    </div>

</main>

{% endblock %}

{% block javascripts %}
{% endblock %}