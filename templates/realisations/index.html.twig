{% extends 'base.html.twig' %}

{% block title %}Mes Réalisations - Mateo{% endblock %}

{% block body %}
<main>
    <h1>Mes Réalisations</h1>

    {% for type, projets in projetsParType %}
        <h2>{{ type|capitalize }}</h2>
        <section class="cards-container">
            {% for projet in projets %}
                <section class="card left" id="projet-{{ projet.id }}">
                    {% if projet.image %}
                        <img src="{{ asset('uploads/projets/' ~ projet.image) }}" alt="{{ projet.titre }}" style="max-width:200px; margin-bottom:10px;">
                    {% endif %}
                    <h3>{{ projet.titre }}</h3>
                    <p>{{ projet.description }}</p>
                    {% if projet.technologies %}
                        <p><strong>Technologies :</strong> {{ projet.technologies }}</p>
                    {% endif %}
                    <p><em>Créé le {{ projet.dateCreation|date('d/m/Y') }}</em></p>

                    <div class="links">
                        {% if projet.lienDemo %}
                            <a href="{{ projet.lienDemo }}" target="_blank">Voir la démo</a>
                        {% endif %}
                        {% if projet.lienGithub %}
                            <a href="{{ projet.lienGithub }}" target="_blank">Voir GitHub</a>
                        {% endif %}
                        {% if projet.rapportPdf %}
                            <a href="{{ asset('uploads/projets/' ~ projet.rapportPdf) }}" target="_blank">Télécharger le PDF</a>
                        {% endif %}
                    </div>
                </section>
            {% else %}
                <p>Aucun projet pour ce type.</p>
            {% endfor %}
        </section>
    {% endfor %}
</main>
{% endblock %}
