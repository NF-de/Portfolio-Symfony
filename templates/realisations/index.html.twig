{% extends 'base.html.twig' %}

{% block title %}Mes Réalisations - Mateo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/realisations.css') }}">
{% endblock %}

{% block body %}
{# Éléments de décor pour l'effet visuel #}
<div class="background-fumee"></div>
<div class="scroll-zone">
    <div class="scroll-content"></div>
    <div class="scroll-overlay"></div>
</div>

<main>
    {# Navbar identique à la page parcours #}
    <nav class="navbar">
        {% if app.user %}
            <form method="post" action="{{ path('app_logout') }}" style="display:inline;">
                <button type="submit" class="btn-logout">Se déconnecter</button>
            </form>
            <a href="{{ path('app_acceuil') }}" class="btn-register">Retour à l'accueil</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="btn-register">Dashboard</a>
            {% endif %}
        {% else %}
            <a href="{{ path('app_login') }}" class="btn-login">Se connecter</a>
            <a href="{{ path('app_register') }}" class="btn-register">Créer un compte</a>
            <a href="{{ path('app_acceuil') }}" class="btn-register">Retour à l'accueil</a>
        {% endif %}
    </nav>

    <div class="hero-card">
        <h1>Mes Réalisations</h1>
    </div>

    {% for type, projets in projetsParType %}
        <h2 class="titre-section-parcours">{{ type|capitalize }}</h2>
        
        <div class="cards-container">
            {% for projet in projets %}
                <section class="card card-horizontal" id="projet-{{ projet.id }}">
                    <div class="card-text">
                        <h3>{{ projet.titre }}</h3>
                        
                        <div class="description-raw">
                            {{ projet.description|raw }}
                        </div>

                        {% if projet.technologies %}
                            <p class="tech-stack"><strong>Technologies :</strong> {{ projet.technologies }}</p>
                        {% endif %}

                        <p class="date-parcours">Créé le {{ projet.dateCreation|date('d/m/Y') }}</p>

                        <div class="links" style="margin-top: 15px;">
                            {% if projet.lienDemo %}
                                <a href="{{ projet.lienDemo }}" target="_blank" class="btn-link">Voir la démo</a>
                            {% endif %}
                            {% if projet.lienGithub %}
                                <a href="{{ projet.lienGithub }}" target="_blank" class="btn-link">GitHub</a>
                            {% endif %}
                            {% if projet.rapportPdf %}
                                <a href="{{ asset('uploads/projets/' ~ projet.rapportPdf) }}" target="_blank" class="btn-link">PDF</a>
                            {% endif %}
                        </div>
                    </div>

                    {% if projet.image %}
                    <div class="card-image">
                        <img src="{{ asset('uploads/projets/' ~ projet.image) }}" alt="{{ projet.titre }}">
                    </div>
                    {% endif %}
                </section>
            {% else %}
                <p style="text-align: center; color: white;">Aucun projet pour ce type.</p>
            {% endfor %}
        </div>
    {% endfor %}

    <footer>
        <h2 class="titre-05 titre-section">Contact</h2>
        <div class="footer-content">
            <span>06 38 53 63 87</span>
            <div class="footer-divider"></div>
            <span>fialouxmateo@gmail.com</span>
            <div class="footer-divider"></div>
            <span>158 Impasse de Beau Chênes, 05400 Oze</span>
        </div>
    </footer>
</main>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('script.js') }}"></script>
{% endblock %}