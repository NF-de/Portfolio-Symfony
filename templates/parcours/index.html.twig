{% extends 'base.html.twig' %}

{% block title %}Mon parcours - Mateo{% endblock %}

{% block body %}
<main>
    <h1>Mon Parcours</h1>

    <section class="cards-container">
        <h2>Formations</h2>
        {% for formation in formations %}
        <section class="card left" id="formation-{{ formation.id }}">
            <h3>{{ formation.titre }}</h3>
            <p><strong>{{ formation.etablissement }}</strong> - {{ formation.ville }}</p>
            <p>{{ formation.description }}</p>
            <p>{{ formation.dateDebut|date('Y') }} - {{ formation.dateFin ? formation.dateFin|date('Y') : 'Présent' }}
            </p>
             {% if formation.image %}
            <img src="{{ asset('uploads/formations/' ~ formation.image) }}" alt="{{ formation.titre }}"
                style="max-width:150px; display:block; margin-bottom:10px;">
            {% endif %}
        </section>
        {% else %}
        <p>Aucune formation enregistrée.</p>
        {% endfor %}

        <h2>Expériences</h2>
        {% for experience in experiences %}
        <section class="card right" id="experience-{{ experience.id }}">
            <h3>{{ experience.poste }}</h3>
            <p><strong>{{ experience.entreprise }}</strong></p>
            <p>{{ experience.description }}</p>
            <p>{{ experience.dateDebut|date('Y') }} - {{ experience.dateFin ? experience.dateFin|date('Y') : 'Présent'
                }}</p>
        </section>
        {% else %}
        <p>Aucune expérience enregistrée.</p>
        {% endfor %}
    </section>
</main>
{% endblock %}