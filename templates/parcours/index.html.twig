{% extends 'base.html.twig' %}

{% block title %}Mon parcours - Mateo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/parcours.css') }}">
{% endblock %}

{% block body %}
<div class="background-fumee"></div>
<div class="scroll-zone">
    <div class="scroll-content"></div>
    <div class="scroll-overlay"></div>
</div>

<main>
    <nav class="navbar">
        {% if app.user %} <form method="post" action="{{ path('app_logout') }}" style="display:inline;">
            <button type="submit" class="btn-logout">Se déconnecter</button>
            </form>
            <a href="{{ path('app_acceuil') }}" class="btn-register">Retour a l'acceuil</a>

            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin') }}" class="btn-register">Dashboard</a>
            {% endif %}
            {% else %}
            <a href="{{ path('app_login') }}" class="btn-login">Se connecter</a>
            <a href="{{ path('app_register') }}" class="btn-register">Créer un compte</a>
            <a href="{{ path('app_acceuil') }}" class="btn-register">Retour a l'acceuil</a>

            {% endif %}>
    </nav>

    <div class="hero-card">
        <h1>Mon Parcours</h1>
    </div>

    <h2 class="titre-section-parcours">Mes Formations</h2>
    <div class="cards-container">
        {% for formation in formations %}
        <section class="card card-horizontal" id="formation-{{ formation.id }}">
            <div class="card-text">
                <h3>{{ formation.titre }}</h3>
                <p><strong>{{ formation.etablissement }}</strong> - {{ formation.ville }}</p>
                <div class="description-raw">{{ formation.description|raw }}</div>
                <p class="date-parcours">{{ formation.dateDebut|date('d/m/Y') }} - {{ formation.dateFin ?
                    formation.dateFin|date('d/m/Y') : 'Présent' }}</p>
            </div>
            {% if formation.image %}
            <div class="card-image">
                <img src="{{ asset('uploads/formations/' ~ formation.image) }}" alt="{{ formation.titre }}">
            </div>
            {% endif %}
        </section>
        {% endfor %}
    </div>

    <h2 class="titre-section-parcours">Mes Expériences</h2>
    <div class="cards-container">
        {% for experience in experiences %}
        <section class="card card-horizontal" id="experience-{{ experience.id }}">
            <div class="card-text">
                <h3>{{ experience.poste }}</h3>
                <p><strong>{{ experience.entreprise }}</strong></p>
                <div class="description-raw">{{ experience.description|raw }}</div>
                <p class="date-parcours">{{ experience.dateDebut|date('Y') }} - {{ experience.dateFin ?
                    experience.dateFin|date('Y') : 'Présent' }}</p>
            </div>
            {% if experience.image is defined and experience.image %}
            <div class="card-image">
                <img src="{{ asset('uploads/experiences/' ~ experience.image) }}" alt="{{ experience.poste }}">
            </div>
            {% endif %}
        </section>
        {% endfor %}
    </div>

    <footer>
        <h2 class="titre-05 titre-section">Contact</h2>
        <div class="footer-content">
            <span>06 38 53 63 87</span>
            <div class="footer-divider"></div>
            <span>fialouxmateo@gmail.com</span>
            <div class="footer-divider"></div>
            <span>158 Impasse de Beau Chênes, 05400 Oze</span>
        </div>
    </footer>
</main>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('script.js') }}"></script>
{% endblock %}