{% extends 'base.html.twig' %}

{% block title %}Veille Technologique - Mateo{% endblock %}

{% block body %}
<main>
    <h1>Veille Technologique</h1>

    {% if veille is not empty %}
        <section class="cards-container">
            {% for item in veille %}
                <section class="card">
                    {% if item.image %}
                        <img src="{{ asset('uploads/veille/' ~ item.image) }}" alt="{{ item.titre }}" style="max-width:200px; margin-bottom:10px;">
                    {% endif %}
                    <h3>{{ item.titre }}</h3>
                    <p>{{ item.description }}</p>
                    {% if item.urlSource %}
                        <p><a href="{{ item.urlSource }}" target="_blank">Voir la source</a></p>
                    {% endif %}
                    <p><em>Publié le {{ item.datePublication|date('d/m/Y') }}</em></p>
                </section>
            {% endfor %}
        </section>
    {% else %}
        <p>Aucun article de veille pour le moment.</p>
    {% endif %}
</main>
{% endblock %}
