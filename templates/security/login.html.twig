{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block body %}

<div class="background-fumee"></div>

<div class="scroll-zone">
    <div class="scroll-content"></div>
    <div class="scroll-overlay"></div>
</div>

<main>


    <!-- CONTENU CENTRÉ -->
    <div class="cards-container">

        <div class="login-wrapper">

            <form method="post" class="card card-center">

                {% if error %}
                    <div class="login-error">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <h2 class="titre-section">Connexion</h2>

                <label>Email</label>
                <input type="email" name="_username" value="{{ last_username }}" required>

                <label>Mot de passe</label>
                <input type="password" name="_password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn-scenik">Se connecter</button>

                <p style="margin-top:15px;">
                    Pas de compte ?
                    <a href="{{ path('app_register') }}">S'inscrire</a>
                </p>

            </form>

        </div>

    </div>

</main>

{% endblock %}

{% block javascripts %}
{% endblock %}