{% extends 'base.html.twig' %}

{% block title %}Portfolio Mateo{% endblock %}

{% block stylesheets %}
{# On importe ton CSS spécifique au portfolio #}
<link rel="stylesheet" href="{{ asset('styles/acceuil.css') }}">
{% endblock %}

{% block body %}
<div class="background-fumee"></div>

{# Zone de connexion ajoutée en haut #}

<div class="scroll-zone">
    <div class="scroll-content"></div>
    <div class="scroll-overlay"></div>
</div>

<main>

    <div class="cards-container">

        <nav class="navbar">
            {% if app.user %}
            {# L'utilisateur est connecté -> bouton de déconnexion #}
            <form method="post" action="{{ path('app_logout') }}" style="display:inline;">
                <button type="submit" class="btn-register">Se déconnecter</button>
            </form>

            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin') }}" class="btn-register">Dashboard</a>
            {% endif %}

            {% else %}
            {# L'utilisateur n'est pas connecté -> boutons login / register #}
            <a href="{{ path('app_login') }}" class="btn-login">Se connecter</a>
            <a href="{{ path('app_register') }}" class="btn-register">Créer un compte</a>
            {% endif %}
        </nav>
        <div class="hero-card">
            <div class="photo">
                <img src="{{ asset('Images/photo.png') }}" alt="Photo" width="200" height="200">
            </div>
            <div class="info">
                <h1><span class="first-name">MATEO</span><br><span class="last-name">FIALOUX</span></h1>
            </div>
        </div>

        <section class="card right" id="section00">
            <a href="{{ path('app_presentation') }}" class="card-link">
                <span class="index">00.</span>
                <h2 class="titre-00 titre-section">Présentation</h2>
                <p class="texte">
                    Je m'appelle Matéo Fialoux, j'ai 19 ans et je suis actuellement en BTS
                    Services Informatiques aux Organisations à Gap.<br><br>
                    Passionné par le développement web, je conçois des sites modernes,
                    performants et intuitifs.<br><br>
                    Mon objectif est de devenir développeur professionnel et de participer
                    à des projets innovants.
                </p>
            </a>
        </section>

        <section class="card left" id="section01">
            <a href="{{ path('app_parcours') }}" class="card-link">
                <span class="index">01.</span>
                <h2 class="titre-01 titre-section">Formations et expériences professionnelles</h2>
                <p class="texte">
                    Cette section présente les formations en ligne que j’ai suivies, incluant des modules de
                    développement, de RGPD et de cybersécurité (SecNum). Elle regroupe également mes expériences
                    professionnelles en entreprise, permettant de mettre en pratique les compétences acquises et de
                    développer mon savoir-faire dans un environnement réel. </p>
            </a>
        </section>
        <section class="card left" id="section02">
            <a href="{{ path('app_realisations') }}" class="card-link">
                <span class="index">02.</span>
                <h2 class="titre-02 titre-section">Réalisations</h2>
                <p class="texte">
                    Cette section regroupe l’ensemble de mes réalisations : projets personnels, Travaux Pratiques (TP),
                    Applications Pratiques (AP) et stages. Elle met en avant les compétences techniques et
                    professionnelles que j’ai développées tout au long de ma formation. </p>
            </a>
        </section>
        <section class="card left" id="section03">
            <a href="{{ path('app_articles') }}" class="card-link">
                <span class="index">03.</span>
                <h2 class="titre-03 titre-section">Rédaction d’articles</h2>
                <p class="texte">
                    Cette section présente mes articles d’information, tels que l’ajout de nouveaux TP, ainsi que des
                    contenus liés à la veille technologique et à ses mises à jour, reflétant mon suivi des évolutions
                    dans le domaine informatique. </p>
            </a>
        </section>

        <section class="card left" id="section04">
            <a href="{{ path('app_veille') }}" class="card-link">
                <span class="index">04.</span>
                <h2 class="titre-04 titre-section">Veille technologique – CSS / SCSS</h2>
                <p class="texte">
                    Réalisation d’une veille sur l’évolution du CSS, de sa création à aujourd’hui, et sur l’intégration
                    des préprocesseurs comme SCSS pour améliorer l’organisation et la maintenabilité des styles.<br><br>

                    Sujets suivis :<br>
                    — CSS 1 (1996) : séparation du contenu et de la présentation (polices, couleurs, marges).<br>
                    — CSS 2.1 (1998-2011) : positionnement, z-index, types de médias, complexité des float pour les
                    colonnes.<br>
                    — CSS3 (2011+) : modules, coins arrondis, dégradés, ombres, transitions et animations.<br>
                    — Flexbox (2012) : alignement et centrage des éléments simplifiés pour le responsive design.<br>
                    — CSS Grid (2017) : gestion simultanée des lignes et colonnes pour des mises en page complexes.<br>
                    — CSS moderne (2022-2026) : fonctionnalités natives comme le nesting, les variables CSS et les
                    fonctions logiques (clamp()), réduisant le besoin d’outils externes comme SCSS.
                </p>
            </a>
        </section>
    </div>

    </div>

    <footer>
        <span class="index">05.</span>
        <h2 class="titre-05 titre-section">Contact</h2>
        <div class="footer-content" id="section05">
            <span>06 38 53 63 87</span>
            <div class="footer-divider"></div>
            <span>fialouxmateo@gmail.com</span>
            <div class="footer-divider"></div>
            <span>158 Impasse de Beau Chênes, 05400 Oze</span>
        </div>
    </footer>
</main>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('script.js') }}"></script>
{% endblock %}