{% extends 'base.html.twig' %}

{% block title %}Présentation - Mateo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/presentation.css') }}">
{% endblock %}

{% block body %}
<div class="background-fumee"></div>

<div class="scroll-zone">
    <div class="scroll-content"></div>
    <div class="scroll-overlay"></div>
</div>

<main>

    <div class="cards-container">

        <nav class="navbar">
            <{% if app.user %} <form method="post" action="{{ path('app_logout') }}" style="display:inline;">
                <button type="submit" class="btn-logout">Se déconnecter</button>
                </form>
                <a href="{{ path('app_acceuil') }}" class="btn-register">Retour a l'acceuil</a>

                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="btn-register">Dashboard</a>
                {% endif %}
                {% else %}
                <a href="{{ path('app_login') }}" class="btn-login">Se connecter</a>
                <a href="{{ path('app_register') }}" class="btn-register">Créer un compte</a>
                <a href="{{ path('app_acceuil') }}" class="btn-register">Retour a l'acceuil</a>

                {% endif %}>
        </nav>

        <div class="hero-card">
            <div class="info">
                <h1>Présentation</h1>
            </div>
        </div>

        <section class="card card-center" id="section00">
            <p class="texte">
                Je m’appelle Matéo Fialoux, j’ai 19 ans et je suis étudiant en BTS SIO (SLAM) à Gap. Passionné par
                l'écosystème web, je me spécialise dans la création d'interfaces modernes, performantes et intuitives.
                <br>
                <br>
                Mon quotidien ? Transformer des idées complexes en expériences fluides en utilisant des outils comme
                Symfony et en explorant les dernières avancées du CSS. Curieux de nature, je vois chaque projet comme un
                nouveau défi technique à relever.
                <br>
                <br>
            <h3>Compétences Techniques</h3>
            <br>
            <br>
            Front-end : HTML5, CSS3/SCSS, JavaScript.
            <br>
            <br>
            Back-end : PHP 8, Symfony, SQL (MySQL, PostgreSQL). 
            <br>
            <br>
            Outils : Git/GitHub, VS Code, Composer.
            <br>
            <br>
            <h3>État d'esprit</h3>
            <br>
            <br>
            Curiosité : J'aime observer les méthodes de mes pairs pour enrichir ma propre palette technique.
            <br>
            <br>
            Rigueur : Je porte une attention particulière à l'accessibilité et à la propreté du code, garantissant un travail d'équipe efficace et un produit final de qualité.
            <br>
            <br>
            <h3>Centres d'intérêt</h3>
            <br>
            <br>
            Arts visuels : Passionné de dessin et de tatouage, je cultive mon sens du détail et de l'esthétique durant mon temps libre.
            <br>
            <br>
            Stratégie & Logique : Amateur d'e-sport et de jeux d'échecs, j'apprécie l'analyse, l'optimisation et la réflexion stratégique.
            </p>
        </section>
        <section class="card card-center" id="competences-section">
            <h2 class="titre-section">Mes Compétences</h2>

            <div class="competences-grid">
                {% for competence in competences %}
                <div class="competence-item">
                    <i class="{{ competence.icone }}"></i>
                    <span class="comp-nom">{{ competence.nom }}</span>

                    {# Barre de progression utilisant le champ 'niveau' #}
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: {{ competence.niveau }}%;"></div>
                    </div>
                    <small>{{ competence.categorie }}</small>
                </div>
                {% else %}
                <p>Aucune compétence enregistrée pour le moment.</p>
                {% endfor %}
            </div>
        </section>
    </div>
    <footer>
        <h2 class="titre-05 titre-section">Contact</h2>
        <div class="footer-content" id="section05">
            <span>06 38 53 63 87</span>
            <div class="footer-divider"></div>
            <span>fialouxmateo@gmail.com</span>
            <div class="footer-divider"></div>
            <span>158 Impasse de Beau Chênes, 05400 Oze</span>
        </div>
    </footer>
</main>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('script.js') }}"></script>
{% endblock %}